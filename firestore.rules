rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) { return request.auth != null && request.auth.uid == uid; }
    match /users/{uid}/profile/main {
      allow read: if owner(uid);
      allow create, update: if owner(uid)
        && request.resource.data.keys().hasOnly(['photo','updatedAt'])
        && request.resource.data.photo is string
        && request.resource.data.photo.size() <= 60000
        && (request.resource.data.photo == '' || request.resource.data.photo.matches('data:image/jpeg;base64,[A-Za-z0-9+/=]+'))
        && request.resource.data.updatedAt == request.time;
    }
    match /users/{uid}/orders/{orderId} {
      allow read: if owner(uid);
      allow create: if owner(uid)
        && request.resource.data.keys().hasOnly(['game','product','price','currency','status','createdAt'])
        && request.resource.data.game is string && request.resource.data.game.size() <= 100
        && request.resource.data.product is string && request.resource.data.product.size() <= 200
        && request.resource.data.price is number && request.resource.data.price > 0
        && request.resource.data.currency == 'PEN'
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time;
      // Solo la administración desde Firebase o un servidor puede confirmar pagos.
      allow update, delete: if false;
    }
  }
}
