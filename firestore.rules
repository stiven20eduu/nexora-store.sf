rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {


    // Notificaciones: contenido privado para su destinatario; envíos solo desde servidor.
    match /users/{uid}/notifications/{noticeId} {
      allow read: if owner(uid);
      allow create, update: if isSupportAdmin()
        && request.resource.data.keys().hasOnly(['kind','title','body','orderId','url','createdAt','authorUid'])
        && request.resource.data.keys().hasAll(['kind','title','body','orderId','url','createdAt','authorUid'])
        && request.resource.data.kind == 'attention'
        && request.resource.data.title == 'Tu pedido necesita tu atención'
        && request.resource.data.body is string
        && request.resource.data.body.size() >= 5 && request.resource.data.body.size() <= 500
        && request.resource.data.orderId is string
        && request.resource.data.orderId.matches('^[A-Za-z0-9-]{1,80}$')
        && noticeId == 'attention-' + request.resource.data.orderId
        && request.resource.data.url is string && request.resource.data.url.size() <= 200
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.createdAt == request.time
        && get(/databases/$(database)/documents/users/$(uid)/orders/$(request.resource.data.orderId)).data.status in ['pending','verified','processing'];
      allow delete: if false;
    }
    match /announcements/{id} {
      // No admitir nuevos mensajes generales.
      allow read, write: if false;
    }
    match /notificationConfig/public {
      allow read: if signedIn();
      allow create, update: if isSupportAdmin()
        && request.resource.data.keys().hasOnly(['vapidKey','updatedAt'])
        && request.resource.data.keys().hasAll(['vapidKey','updatedAt'])
        && request.resource.data.vapidKey is string
        && request.resource.data.vapidKey.matches('^[A-Za-z0-9_-]{87,88}$')
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }
    match /pushDevices/{id} { allow read, write: if false; }
    match /notificationDeliveries/{id} { allow read, write: if false; }

    function signedIn() {
      return request.auth != null;
    }

    function owner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isMvp() {
      return signedIn()
        && request.auth.token.email in [
          'nexora.store.sf@gmail.com',
          'stiven20eduu@gmail.com'
        ];
    }


    // Soporte NEXORA: cada cliente ve solo sus casos y capturas.
    // Solo cuentas MVP verificadas pueden abrir la bandeja y responder.
    function isSupportAdmin() {
      return isMvp() && request.auth.token.email_verified == true;
    }

    match /supportTickets/{ticketId} {
      allow get, list: if isSupportAdmin()
        || (signedIn() && resource.data.uid == request.auth.uid);

      allow create: if signedIn()
        && ticketId.matches('^[A-Za-z0-9_-]{8,80}$')
        && request.resource.data.keys().hasOnly([
          'uid','category','subject','description','orderId','imageCount','status','createdAt'
        ])
        && request.resource.data.keys().hasAll([
          'uid','category','subject','description','orderId','imageCount','status','createdAt'
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.category in ['pedido','saldo','cuenta','producto','otro']
        && request.resource.data.subject is string
        && request.resource.data.subject.size() >= 5
        && request.resource.data.subject.size() <= 100
        && request.resource.data.description is string
        && request.resource.data.description.size() >= 20
        && request.resource.data.description.size() <= 2000
        && request.resource.data.orderId is string
        && request.resource.data.orderId.size() <= 80
        && request.resource.data.imageCount is int
        && request.resource.data.imageCount >= 0
        && request.resource.data.imageCount <= 3
        && request.resource.data.status == 'open'
        && request.resource.data.createdAt == request.time;

      allow update: if isSupportAdmin()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status','adminReply','reviewedBy','updatedAt'])
        && request.resource.data.keys().hasAll(['status','adminReply','reviewedBy','updatedAt'])
        && request.resource.data.status in ['open','reviewing','resolved']
        && request.resource.data.adminReply is string
        && request.resource.data.adminReply.size() <= 1000
        && (request.resource.data.status != 'resolved'
            || request.resource.data.adminReply.size() >= 5)
        && request.resource.data.reviewedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time;

      allow delete: if false;

      match /images/{imageId} {
        allow get, list: if isSupportAdmin()
          || (signedIn() && get(/databases/$(database)/documents/supportTickets/$(ticketId)).data.uid == request.auth.uid);

        allow create: if signedIn()
          && imageId.matches('^[0-2]$')
          && request.resource.data.keys().hasOnly(['uid','image','createdAt'])
          && request.resource.data.keys().hasAll(['uid','image','createdAt'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.image is string
          && request.resource.data.image.size() <= 155000
          && request.resource.data.image.matches('^data:image/jpeg;base64,[A-Za-z0-9+/=]+$')
          && request.resource.data.createdAt == request.time
          && getAfter(/databases/$(database)/documents/supportTickets/$(ticketId)).data.uid == request.auth.uid
          && getAfter(/databases/$(database)/documents/supportTickets/$(ticketId)).data.imageCount >= (
            imageId == '0' ? 1 : (imageId == '1' ? 2 : 3)
          );

        allow update, delete: if false;
      }
    }

    // Chat privado: solo el miembro y el MVP que abrió su conversación.
    function chatParticipant(uid, adminUid) {
      return signedIn() && (request.auth.uid == uid || request.auth.uid == adminUid);
    }

    match /users/{uid}/privateChats/{adminUid} {
      allow get: if chatParticipant(uid, adminUid);
      allow list: if owner(uid);
      allow create: if isWalletAdmin() && request.auth.uid == adminUid && uid != adminUid
        && exists(/databases/$(database)/documents/users/$(uid))
        && request.resource.data.keys().hasOnly(['memberUid', 'adminUid', 'createdAt'])
        && request.resource.data.keys().hasAll(['memberUid', 'adminUid', 'createdAt'])
        && request.resource.data.memberUid == uid
        && request.resource.data.adminUid == adminUid
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;

      // El índice contiene únicamente identificadores y fechas, nunca texto.
      // Permite localizar mensajes recientes sin exponer los ya caducados.
      match /messageIndex/{messageId} {
        allow read: if chatParticipant(uid, adminUid);
        allow create: if chatParticipant(uid, adminUid)
          && exists(/databases/$(database)/documents/users/$(uid)/privateChats/$(adminUid))
          && request.resource.data.keys().hasOnly(['senderUid','createdAt'])
          && request.resource.data.keys().hasAll(['senderUid','createdAt'])
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.createdAt == request.time
          && getAfter(/databases/$(database)/documents/users/$(uid)/privateChats/$(adminUid)/privateMessages/$(messageId)).data.senderUid == request.auth.uid
          && getAfter(/databases/$(database)/documents/users/$(uid)/privateChats/$(adminUid)/privateMessages/$(messageId)).data.createdAt == request.time;
        allow update, delete: if false;
      }

      match /privateMessages/{messageId} {
        allow get: if chatParticipant(uid, adminUid)
          && request.time < resource.data.createdAt + duration.value(24, 'h');
        allow list: if false;
        allow create: if chatParticipant(uid, adminUid)
          && exists(/databases/$(database)/documents/users/$(uid)/privateChats/$(adminUid))
          && request.resource.data.keys().hasOnly(['senderUid','text','createdAt'])
          && request.resource.data.keys().hasAll(['senderUid','text','createdAt'])
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() >= 1
          && request.resource.data.text.size() <= 2000
          && request.resource.data.createdAt == request.time
          && getAfter(/databases/$(database)/documents/users/$(uid)/privateChats/$(adminUid)/messageIndex/$(messageId)).data.senderUid == request.auth.uid
          && getAfter(/databases/$(database)/documents/users/$(uid)/privateChats/$(adminUid)/messageIndex/$(messageId)).data.createdAt == request.time;
        allow update, delete: if false;
      }
    }

    match /users/{uid} {
      allow read: if owner(uid) || isMvp();

      allow create: if owner(uid)
        && request.resource.data.keys().hasOnly(['displayName','joinedAt'])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 60
        && request.resource.data.joinedAt is string
        && request.resource.data.joinedAt.size() <= 80;

      allow update: if owner(uid)
        && request.resource.data.keys().hasOnly(['displayName','joinedAt'])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 60
        && request.resource.data.joinedAt == resource.data.joinedAt;

      allow delete: if false;
    }

    match /users/{uid}/profile/main {
      allow read: if owner(uid) || isMvp();

      allow create, update: if owner(uid)
        && request.resource.data.keys().hasOnly(['photo','updatedAt'])
        && request.resource.data.photo is string
        && request.resource.data.photo.size() <= 60000
        && (
          request.resource.data.photo == ''
          || request.resource.data.photo.matches('data:image/jpeg;base64,[A-Za-z0-9+/=]+')
        )
        && request.resource.data.updatedAt == request.time;

      allow delete: if false;
    }

    // El cliente solo puede crear un pedido con saldo y precio validado,
    // descontando exactamente el mismo importe en la misma transacción.
    function validWalletOrder(uid, orderId) {
      let walletPath = /databases/$(database)/documents/users/$(uid)/wallet/main;
      let itemPath = /databases/$(database)/documents/catalogPrices/$(request.resource.data.catalogId);
      let product = get(itemPath).data;
      let walletBefore = get(walletPath).data;
      let walletAfter = getAfter(walletPath).data;
      return owner(uid)
        && request.resource.data.keys().hasOnly([
          'game', 'product', 'price', 'priceCents', 'currency',
          'status', 'createdAt', 'paymentMethod', 'catalogId',
          'playerId', 'serverId', 'playerName', 'playerRegion'
        ])
        && request.resource.data.keys().hasAll([
          'game', 'product', 'price', 'priceCents', 'currency',
          'status', 'createdAt', 'paymentMethod', 'catalogId',
          'playerId', 'serverId', 'playerName', 'playerRegion'
        ])
        && request.resource.data.paymentMethod == 'wallet'
        && request.resource.data.status == 'verified'
        && request.resource.data.currency == 'PEN'
        && request.resource.data.createdAt == request.time
        && request.resource.data.catalogId is string
        && request.resource.data.catalogId.size() > 0
        && request.resource.data.catalogId.size() <= 400
        && product.enabled == true
        && product.priceCents is int
        && request.resource.data.game == product.game
        && request.resource.data.product == product.product
        && request.resource.data.priceCents == product.priceCents
        && request.resource.data.price == product.priceCents / 100.0
        && request.resource.data.playerId is string
        && request.resource.data.playerId.size() <= 100
        && request.resource.data.serverId is string
        && request.resource.data.serverId.size() <= 100
        && request.resource.data.playerName is string
        && request.resource.data.playerName.size() <= 120
        && request.resource.data.playerRegion is string
        && request.resource.data.playerRegion.size() <= 100
        && walletBefore.balanceCents is int
        && walletBefore.balanceCents >= product.priceCents
        && walletAfter.balanceCents == walletBefore.balanceCents - product.priceCents
        && walletAfter.lastPurchaseId == orderId;
    }

    match /users/{uid}/orders/{orderId} {
      allow read: if owner(uid) || isMvp();

      allow create: if (owner(uid)
        && request.resource.data.keys().hasOnly([
          'game',
          'product',
          'price',
          'currency',
          'status',
          'createdAt'
        ])
        && request.resource.data.game is string
        && request.resource.data.game.size() <= 100
        && request.resource.data.product is string
        && request.resource.data.product.size() <= 200
        && request.resource.data.price is number
        && request.resource.data.price > 0
        && request.resource.data.currency == 'PEN'
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time)
        || validWalletOrder(uid, orderId);

      // Cambios habituales: nunca permitir completar Roblox sin código.
      // Se exige que el pedido esté activo para evitar reabrir entregas pasadas.
      allow update: if isMvp()
        && resource.data.status in ['pending', 'verified', 'processing']
        && (
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
            && request.resource.data.status in [
              'pending', 'processing', 'verified', 'completed', 'cancelled'
            ]
            && !(resource.data.game == 'Roblox'
              && request.resource.data.status == 'completed')
          )
          ||
          (
            // Entrega de Roblox: completar y registrar el código en el mismo commit.
            request.auth.token.email_verified == true
            && resource.data.game == 'Roblox'
            && resource.data.status in ['verified', 'processing']
            && request.resource.data.status == 'completed'
            && !resource.data.keys().hasAny([
              'redemptionCode', 'redemptionAddedAt', 'redemptionAddedBy'
            ])
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status', 'redemptionCode', 'redemptionAddedAt', 'redemptionAddedBy'
            ])
            && request.resource.data.diff(resource.data).affectedKeys().hasAll([
              'status', 'redemptionCode', 'redemptionAddedAt', 'redemptionAddedBy'
            ])
            && request.resource.data.redemptionCode is string
            && request.resource.data.redemptionCode.matches('^[A-Za-z0-9][A-Za-z0-9-]{7,79}

      allow delete: if false;
    }

    // Las recargas de dinero solo pueden aprobarse con una cuenta administradora verificada.
    function isWalletAdmin() {
      return isMvp() && request.auth.token.email_verified == true;
    }

    match /yapeTopups/{topupId} {
      allow get, list: if isWalletAdmin()
        || (signedIn() && resource.data.uid == request.auth.uid);

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'uid', 'amountCents', 'yapeOperation', 'payerName', 'status', 'createdAt',
          'proofImage', 'proofUploadedAt'
        ])
        && request.resource.data.keys().hasAll([
          'uid', 'amountCents', 'yapeOperation', 'payerName', 'status', 'createdAt'
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.amountCents is int
        && request.resource.data.amountCents >= 1000
        && request.resource.data.amountCents <= 100000
        && request.resource.data.yapeOperation is string
        && request.resource.data.yapeOperation.matches('^[0-9]{6,16}$')
        && request.resource.data.payerName is string
        && request.resource.data.payerName.size() <= 80
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time
        // La imagen es opcional para no interrumpir versiones anteriores de la web.
        // Debe ser un JPEG reducido (PNG se convertirá antes de enviarlo).
        && (
          !request.resource.data.keys().hasAny(['proofImage', 'proofUploadedAt'])
          || (
            request.resource.data.keys().hasAll(['proofImage', 'proofUploadedAt'])
            && request.resource.data.proofImage is string
            && request.resource.data.proofImage.size() <= 180000
            && request.resource.data.proofImage.matches('^data:image/jpeg;base64,[A-Za-z0-9+/=]+$')
            && request.resource.data.proofUploadedAt == request.time
          )
        );

      allow update: if isWalletAdmin()
        && resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'processedAt', 'processedBy'])
        && request.resource.data.status in ['approved', 'rejected']
        && request.resource.data.processedBy == request.auth.uid
        && request.resource.data.processedAt == request.time;

      allow delete: if false;
    }

    // Descuento solo si existe un pedido nuevo, pagado en el mismo commit.
    function validWalletDebit(uid) {
      let purchaseId = request.resource.data.lastPurchaseId;
      let orderPath = /databases/$(database)/documents/users/$(uid)/orders/$(purchaseId);
      let order = getAfter(orderPath).data;
      return owner(uid)
        && resource.data.balanceCents is int
        && resource.data.balanceCents >= 0
        && request.resource.data.keys().hasOnly(['balanceCents', 'updatedAt', 'lastPurchaseId'])
        && request.resource.data.keys().hasAll(['balanceCents', 'updatedAt', 'lastPurchaseId'])
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['balanceCents', 'updatedAt', 'lastPurchaseId'])
        && request.resource.data.balanceCents is int
        && request.resource.data.balanceCents >= 0
        && request.resource.data.balanceCents < resource.data.balanceCents
        && request.resource.data.updatedAt == request.time
        && purchaseId is string
        && purchaseId.size() > 0
        && purchaseId.size() <= 80
        && purchaseId != resource.data.get('lastPurchaseId', '')
        && !exists(orderPath)
        && order.paymentMethod == 'wallet'
        && order.status == 'verified'
        && order.createdAt == request.time
        && order.priceCents == resource.data.balanceCents - request.resource.data.balanceCents;
    }

    match /users/{uid}/wallet/{walletId} {
      allow get: if walletId == 'main' && (owner(uid) || isWalletAdmin());
      allow list: if false;

      allow create: if walletId == 'main'
        && isWalletAdmin()
        && request.resource.data.keys().hasOnly(['balanceCents', 'updatedAt'])
        && request.resource.data.keys().hasAll(['balanceCents', 'updatedAt'])
        && request.resource.data.balanceCents is int
        && request.resource.data.balanceCents >= 0
        && request.resource.data.balanceCents <= 100000000
        && request.resource.data.updatedAt == request.time;

      allow update: if walletId == 'main' && (
        (isWalletAdmin()
          && request.resource.data.keys().hasOnly(['balanceCents', 'updatedAt', 'lastPurchaseId'])
          && request.resource.data.keys().hasAll(['balanceCents', 'updatedAt'])
          && request.resource.data.balanceCents is int
          && request.resource.data.balanceCents >= 0
          && request.resource.data.balanceCents <= 100000000
          && request.resource.data.updatedAt == request.time)
        || validWalletDebit(uid)
      );
      allow delete: if false;
    }

    // Precios oficiales utilizados para futuros pagos con saldo.
    // Solo administradores con correo verificado pueden modificarlos.
    match /catalogPrices/{productId} {
      allow get, list: if true;

      allow create, update: if isWalletAdmin()
        && request.resource.data.keys().hasOnly([
          'gameKey', 'game', 'product', 'priceCents', 'enabled', 'updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'gameKey', 'game', 'product', 'priceCents', 'enabled', 'updatedAt'
        ])
        && request.resource.data.gameKey is string
        && request.resource.data.gameKey.size() > 0
        && request.resource.data.gameKey.size() <= 80
        && request.resource.data.game is string
        && request.resource.data.game.size() > 0
        && request.resource.data.game.size() <= 100
        && request.resource.data.product is string
        && request.resource.data.product.size() > 0
        && request.resource.data.product.size() <= 200
        && request.resource.data.priceCents is int
        && request.resource.data.priceCents >= 100
        && request.resource.data.priceCents <= 100000
        && request.resource.data.enabled is bool
        && request.resource.data.updatedAt == request.time;

      allow delete: if false;
    }

    // Bloquea reutilizar un número de operación al aprobar otra solicitud.
    match /yapeOperations/{operation} {
      allow get: if isWalletAdmin();
      allow list: if false;
      allow create: if isWalletAdmin()
        && operation.matches('^[0-9]{6,16}$')
        && request.resource.data.keys().hasOnly(['topupId', 'uid', 'amountCents', 'usedAt'])
        && request.resource.data.keys().hasAll(['topupId', 'uid', 'amountCents', 'usedAt'])
        && request.resource.data.topupId is string
        && request.resource.data.uid is string
        && request.resource.data.amountCents is int
        && request.resource.data.amountCents >= 100
        && request.resource.data.usedAt == request.time;
      allow update, delete: if false;
    }
  }
}

)
            && request.resource.data.redemptionAddedAt == request.time
            && request.resource.data.redemptionAddedBy == request.auth.uid
          )
        );

      allow delete: if false;
    }

    // Las recargas de dinero solo pueden aprobarse con una cuenta administradora verificada.
    function isWalletAdmin() {
      return isMvp() && request.auth.token.email_verified == true;
    }

    match /yapeTopups/{topupId} {
      allow get, list: if isWalletAdmin()
        || (signedIn() && resource.data.uid == request.auth.uid);

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'uid', 'amountCents', 'yapeOperation', 'payerName', 'status', 'createdAt',
          'proofImage', 'proofUploadedAt'
        ])
        && request.resource.data.keys().hasAll([
          'uid', 'amountCents', 'yapeOperation', 'payerName', 'status', 'createdAt'
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.amountCents is int
        && request.resource.data.amountCents >= 1000
        && request.resource.data.amountCents <= 100000
        && request.resource.data.yapeOperation is string
        && request.resource.data.yapeOperation.matches('^[0-9]{6,16}$')
        && request.resource.data.payerName is string
        && request.resource.data.payerName.size() <= 80
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time
        // La imagen es opcional para no interrumpir versiones anteriores de la web.
        // Debe ser un JPEG reducido (PNG se convertirá antes de enviarlo).
        && (
          !request.resource.data.keys().hasAny(['proofImage', 'proofUploadedAt'])
          || (
            request.resource.data.keys().hasAll(['proofImage', 'proofUploadedAt'])
            && request.resource.data.proofImage is string
            && request.resource.data.proofImage.size() <= 180000
            && request.resource.data.proofImage.matches('^data:image/jpeg;base64,[A-Za-z0-9+/=]+$')
            && request.resource.data.proofUploadedAt == request.time
          )
        );

      allow update: if isWalletAdmin()
        && resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'processedAt', 'processedBy'])
        && request.resource.data.status in ['approved', 'rejected']
        && request.resource.data.processedBy == request.auth.uid
        && request.resource.data.processedAt == request.time;

      allow delete: if false;
    }

    // Descuento solo si existe un pedido nuevo, pagado en el mismo commit.
    function validWalletDebit(uid) {
      let purchaseId = request.resource.data.lastPurchaseId;
      let orderPath = /databases/$(database)/documents/users/$(uid)/orders/$(purchaseId);
      let order = getAfter(orderPath).data;
      return owner(uid)
        && resource.data.balanceCents is int
        && resource.data.balanceCents >= 0
        && request.resource.data.keys().hasOnly(['balanceCents', 'updatedAt', 'lastPurchaseId'])
        && request.resource.data.keys().hasAll(['balanceCents', 'updatedAt', 'lastPurchaseId'])
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['balanceCents', 'updatedAt', 'lastPurchaseId'])
        && request.resource.data.balanceCents is int
        && request.resource.data.balanceCents >= 0
        && request.resource.data.balanceCents < resource.data.balanceCents
        && request.resource.data.updatedAt == request.time
        && purchaseId is string
        && purchaseId.size() > 0
        && purchaseId.size() <= 80
        && purchaseId != resource.data.get('lastPurchaseId', '')
        && !exists(orderPath)
        && order.paymentMethod == 'wallet'
        && order.status == 'verified'
        && order.createdAt == request.time
        && order.priceCents == resource.data.balanceCents - request.resource.data.balanceCents;
    }

    match /users/{uid}/wallet/{walletId} {
      allow get: if walletId == 'main' && (owner(uid) || isWalletAdmin());
      allow list: if false;

      allow create: if walletId == 'main'
        && isWalletAdmin()
        && request.resource.data.keys().hasOnly(['balanceCents', 'updatedAt'])
        && request.resource.data.keys().hasAll(['balanceCents', 'updatedAt'])
        && request.resource.data.balanceCents is int
        && request.resource.data.balanceCents >= 0
        && request.resource.data.balanceCents <= 100000000
        && request.resource.data.updatedAt == request.time;

      allow update: if walletId == 'main' && (
        (isWalletAdmin()
          && request.resource.data.keys().hasOnly(['balanceCents', 'updatedAt', 'lastPurchaseId'])
          && request.resource.data.keys().hasAll(['balanceCents', 'updatedAt'])
          && request.resource.data.balanceCents is int
          && request.resource.data.balanceCents >= 0
          && request.resource.data.balanceCents <= 100000000
          && request.resource.data.updatedAt == request.time)
        || validWalletDebit(uid)
      );
      allow delete: if false;
    }

    // Precios oficiales utilizados para futuros pagos con saldo.
    // Solo administradores con correo verificado pueden modificarlos.
    match /catalogPrices/{productId} {
      allow get, list: if true;

      allow create, update: if isWalletAdmin()
        && request.resource.data.keys().hasOnly([
          'gameKey', 'game', 'product', 'priceCents', 'enabled', 'updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'gameKey', 'game', 'product', 'priceCents', 'enabled', 'updatedAt'
        ])
        && request.resource.data.gameKey is string
        && request.resource.data.gameKey.size() > 0
        && request.resource.data.gameKey.size() <= 80
        && request.resource.data.game is string
        && request.resource.data.game.size() > 0
        && request.resource.data.game.size() <= 100
        && request.resource.data.product is string
        && request.resource.data.product.size() > 0
        && request.resource.data.product.size() <= 200
        && request.resource.data.priceCents is int
        && request.resource.data.priceCents >= 100
        && request.resource.data.priceCents <= 100000
        && request.resource.data.enabled is bool
        && request.resource.data.updatedAt == request.time;

      allow delete: if false;
    }

    // Bloquea reutilizar un número de operación al aprobar otra solicitud.
    match /yapeOperations/{operation} {
      allow get: if isWalletAdmin();
      allow list: if false;
      allow create: if isWalletAdmin()
        && operation.matches('^[0-9]{6,16}$')
        && request.resource.data.keys().hasOnly(['topupId', 'uid', 'amountCents', 'usedAt'])
        && request.resource.data.keys().hasAll(['topupId', 'uid', 'amountCents', 'usedAt'])
        && request.resource.data.topupId is string
        && request.resource.data.uid is string
        && request.resource.data.amountCents is int
        && request.resource.data.amountCents >= 100
        && request.resource.data.usedAt == request.time;
      allow update, delete: if false;
    }
  }
}

